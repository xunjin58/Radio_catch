[
  {
    "start": 0.25,
    "end": 2.591,
    "text": "黑盘里的绿色柠檬片铺满一盘，"
  },
  {
    "start": 2.591,
    "end": 4.752,
    "text": "整果和切片前后都在画面里，"
  },
  {
    "start": 4.752,
    "end": 6.192,
    "text": "拿一颗放到砧板上，"
  },
  {
    "start": 6.192,
    "end": 8.173,
    "text": "黄色柠檬也切成薄片备用。"
  },
  {
    "start": 8.173,
    "end": 9.433,
    "text": "取一片放进杯里，"
  },
  {
    "start": 9.433,
    "end": 10.514,
    "text": "再倒入气泡水，"
  },
  {
    "start": 10.514,
    "end": 12.674,
    "text": "细小的泡泡在杯中不断升起，"
  },
  {
    "start": 12.674,
    "end": 13.935,
    "text": "杯子放在小盘上。"
  },
  {
    "start": 13.935,
    "end": 15.375,
    "text": "小小一杯慢慢装满，"
  },
  {
    "start": 15.375,
    "end": 16.816,
    "text": "镜头回到整盘切片，"
  },
  {
    "start": 16.816,
    "end": 19.337,
    "text": "绿色果皮和圆圆的切面都看得清"
  },
  {
    "start": 19.337,
    "end": 19.517,
    "text": "楚。"
  },
  {
    "start": 19.517,
    "end": 20.72,
    "text": "想做一杯柠檬饮，"
  },
  {
    "start": 20.72,
    "end": 23.126,
    "text": "在家照着这样的步骤慢慢泡就行"
  },
  {
    "start": 23.126,
    "end": 23.298,
    "text": "。"
  }
]
