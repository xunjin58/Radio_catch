[
  {
    "start": 0.25,
    "end": 2.358,
    "text": "青柠和黄柠檬先切成薄片，"
  },
  {
    "start": 2.358,
    "end": 4.083,
    "text": "放进加了冰块的杯里，"
  },
  {
    "start": 4.083,
    "end": 5.424,
    "text": "慢慢倒入矿泉水。"
  },
  {
    "start": 5.424,
    "end": 6.766,
    "text": "柠檬片浮在杯中，"
  },
  {
    "start": 6.766,
    "end": 8.299,
    "text": "水珠慢慢挂上杯壁，"
  },
  {
    "start": 8.299,
    "end": 10.407,
    "text": "最后在杯口放一片黄柠檬。"
  },
  {
    "start": 10.407,
    "end": 11.365,
    "text": "切片放进去，"
  },
  {
    "start": 11.365,
    "end": 12.898,
    "text": "冰块在杯里碰一碰，"
  },
  {
    "start": 12.898,
    "end": 13.856,
    "text": "再慢慢倒满，"
  },
  {
    "start": 13.856,
    "end": 15.964,
    "text": "画面里每一步都看得清楚。"
  },
  {
    "start": 15.964,
    "end": 17.06,
    "text": "从切片到装饰，"
  },
  {
    "start": 17.06,
    "end": 19.615,
    "text": "想在家做杯冰饮照着这样泡就行"
  },
  {
    "start": 19.615,
    "end": 19.797,
    "text": "。"
  }
]
