[
  {
    "start": 0.25,
    "end": 2.215,
    "text": "黄色柠檬一片片叠在碗里，"
  },
  {
    "start": 2.215,
    "end": 4.001,
    "text": "圆圆的切面看得很清楚，"
  },
  {
    "start": 4.001,
    "end": 5.43,
    "text": "现切几片放进杯中，"
  },
  {
    "start": 5.43,
    "end": 7.216,
    "text": "准备一杯简单的柠檬饮。"
  },
  {
    "start": 7.216,
    "end": 8.645,
    "text": "维C含量高的柠檬，"
  },
  {
    "start": 8.645,
    "end": 9.895,
    "text": "配上气泡水一倒，"
  },
  {
    "start": 9.895,
    "end": 11.324,
    "text": "泡泡从杯底往上冒，"
  },
  {
    "start": 11.324,
    "end": 12.931,
    "text": "柠檬片也跟着浮起来。"
  },
  {
    "start": 12.931,
    "end": 15.074,
    "text": "镜头换到绿色果皮的柠檬片，"
  },
  {
    "start": 15.074,
    "end": 17.396,
    "text": "另一只杯子里也冒着细小气泡，"
  },
  {
    "start": 17.396,
    "end": 18.647,
    "text": "两种颜色换着泡。"
  },
  {
    "start": 18.647,
    "end": 20.2,
    "text": "看着一杯接一杯完成，"
  },
  {
    "start": 20.2,
    "end": 21.236,
    "text": "最后端起成品，"
  },
  {
    "start": 21.236,
    "end": 23.654,
    "text": "想喝的时候自己动手泡一杯就行"
  },
  {
    "start": 23.654,
    "end": 23.826,
    "text": "。"
  }
]
