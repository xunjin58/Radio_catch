[
  {
    "start": 0.25,
    "end": 1.628,
    "text": "九块九买两斤柠檬，"
  },
  {
    "start": 1.628,
    "end": 3.007,
    "text": "到手到底够用多久？"
  },
  {
    "start": 3.007,
    "end": 4.213,
    "text": "平时泡水、做冷饮，"
  },
  {
    "start": 4.213,
    "end": 5.935,
    "text": "几颗就能换出不少口味。"
  },
  {
    "start": 5.935,
    "end": 8.175,
    "text": "这个广东香水柠檬个头很实在，"
  },
  {
    "start": 8.175,
    "end": 8.692,
    "text": "皮也薄，"
  },
  {
    "start": 8.692,
    "end": 10.587,
    "text": "无籽吃起来不用挑来挑去。"
  },
  {
    "start": 10.587,
    "end": 12.138,
    "text": "维C高又是现摘现发，"
  },
  {
    "start": 12.138,
    "end": 13.516,
    "text": "收到手慢慢用就好。"
  },
  {
    "start": 13.516,
    "end": 15.411,
    "text": "周末做一大壶，大家都能喝。"
  },
  {
    "start": 15.411,
    "end": 17.478,
    "text": "家里常做饭、也爱喝饮品的话，"
  },
  {
    "start": 17.478,
    "end": 19.201,
    "text": "放一袋在冰箱里挺踏实，"
  },
  {
    "start": 19.201,
    "end": 20.063,
    "text": "拿着也方便。"
  }
]
