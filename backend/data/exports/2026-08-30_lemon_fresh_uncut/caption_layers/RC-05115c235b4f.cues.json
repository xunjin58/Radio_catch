[
  {
    "start": 0.25,
    "end": 1.841,
    "text": "喜欢浓一点柠檬香的，"
  },
  {
    "start": 1.841,
    "end": 4.317,
    "text": "可以把这份广东香水柠檬记下来"
  },
  {
    "start": 4.317,
    "end": 4.494,
    "text": "。"
  },
  {
    "start": 4.494,
    "end": 6.154,
    "text": "果子个头大，汁水也足，"
  },
  {
    "start": 6.154,
    "end": 8.0,
    "text": "做饮品时香气会更明显。"
  },
  {
    "start": 8.0,
    "end": 8.922,
    "text": "九块九两斤，"
  },
  {
    "start": 8.922,
    "end": 10.952,
    "text": "不是只够喝一两次的分量，"
  },
  {
    "start": 10.952,
    "end": 12.797,
    "text": "放在家里可以慢慢搭配。"
  },
  {
    "start": 12.797,
    "end": 15.011,
    "text": "早上泡一杯，下午换一种搭配，"
  },
  {
    "start": 15.011,
    "end": 16.672,
    "text": "几天都不会觉得重复。"
  },
  {
    "start": 16.672,
    "end": 17.963,
    "text": "现摘现发，自己喝、"
  },
  {
    "start": 17.963,
    "end": 19.808,
    "text": "朋友来家里招待都方便。"
  },
  {
    "start": 19.808,
    "end": 21.469,
    "text": "夏天想过得清爽一点，"
  },
  {
    "start": 21.469,
    "end": 23.13,
    "text": "从冰箱里备几颗开始。"
  }
]
