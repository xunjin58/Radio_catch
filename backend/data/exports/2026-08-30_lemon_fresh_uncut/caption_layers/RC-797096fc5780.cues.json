[
  {
    "start": 0.25,
    "end": 1.703,
    "text": "午后不想再点甜饮料，"
  },
  {
    "start": 1.703,
    "end": 3.963,
    "text": "我现在更爱在冰箱留一杯柠檬水"
  },
  {
    "start": 3.963,
    "end": 4.125,
    "text": "。"
  },
  {
    "start": 4.125,
    "end": 5.473,
    "text": "酸香是清清爽爽的，"
  },
  {
    "start": 5.473,
    "end": 7.157,
    "text": "喝完嘴里不会黏着甜味。"
  },
  {
    "start": 7.157,
    "end": 8.673,
    "text": "这个柠檬泡水很合适，"
  },
  {
    "start": 8.673,
    "end": 10.527,
    "text": "汁水也足，配冰水就很舒服。"
  },
  {
    "start": 10.527,
    "end": 12.548,
    "text": "喝水这件事也会更容易坚持。"
  },
  {
    "start": 12.548,
    "end": 14.738,
    "text": "广东香水柠檬两斤只要九块九，"
  },
  {
    "start": 14.738,
    "end": 15.749,
    "text": "还是现摘现发。"
  },
  {
    "start": 15.749,
    "end": 17.097,
    "text": "早餐后、忙完工作后，"
  },
  {
    "start": 17.097,
    "end": 18.95,
    "text": "给自己留几分钟慢慢喝吧，"
  },
  {
    "start": 18.95,
    "end": 20.129,
    "text": "整个人都松快些。"
  }
]
