[
  {
    "start": 0.25,
    "end": 1.98,
    "text": "气泡水里加两片柠檬，"
  },
  {
    "start": 1.98,
    "end": 4.671,
    "text": "夏天这一口比只喝白水有意思多"
  },
  {
    "start": 4.671,
    "end": 4.863,
    "text": "了。"
  },
  {
    "start": 4.863,
    "end": 6.4,
    "text": "酸香出来得很自然，"
  },
  {
    "start": 6.4,
    "end": 7.746,
    "text": "冰过以后更清爽。"
  },
  {
    "start": 7.746,
    "end": 9.283,
    "text": "不用准备太多东西，"
  },
  {
    "start": 9.283,
    "end": 10.629,
    "text": "味道就很有层次。"
  },
  {
    "start": 10.629,
    "end": 11.974,
    "text": "这个果子汁水足，"
  },
  {
    "start": 11.974,
    "end": 13.896,
    "text": "做饮品不用费心调半天。"
  },
  {
    "start": 13.896,
    "end": 16.394,
    "text": "广东香水柠檬现在九块九两斤，"
  },
  {
    "start": 16.394,
    "end": 17.932,
    "text": "还是果园现摘现发。"
  },
  {
    "start": 17.932,
    "end": 20.238,
    "text": "家里备着，下午想换个口味时，"
  },
  {
    "start": 20.238,
    "end": 22.16,
    "text": "随手就能给自己做一杯，"
  },
  {
    "start": 22.16,
    "end": 23.121,
    "text": "也不容易腻。"
  }
]
