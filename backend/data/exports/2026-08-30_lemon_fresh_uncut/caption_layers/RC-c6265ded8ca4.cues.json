[
  {
    "start": 0.25,
    "end": 1.999,
    "text": "吃完火锅嘴里有点腻时，"
  },
  {
    "start": 1.999,
    "end": 4.099,
    "text": "我会想喝点带柠檬香的冰饮。"
  },
  {
    "start": 4.099,
    "end": 5.498,
    "text": "可乐里加一点酸香，"
  },
  {
    "start": 5.498,
    "end": 7.248,
    "text": "味道更有层次；想轻一点，"
  },
  {
    "start": 7.248,
    "end": 8.822,
    "text": "换成气泡水也很合适。"
  },
  {
    "start": 8.822,
    "end": 10.572,
    "text": "味道有变化，也不怕重复。"
  },
  {
    "start": 10.572,
    "end": 11.796,
    "text": "这个果子汁水足，"
  },
  {
    "start": 11.796,
    "end": 13.196,
    "text": "做一杯不必放太多。"
  },
  {
    "start": 13.196,
    "end": 14.946,
    "text": "按杯买饮料常常十几块，"
  },
  {
    "start": 14.946,
    "end": 17.395,
    "text": "在家备这份九块九两斤的广东香"
  },
  {
    "start": 17.395,
    "end": 19.144,
    "text": "水柠檬，晚餐后想喝就有，"
  },
  {
    "start": 19.144,
    "end": 20.019,
    "text": "更不容易腻。"
  }
]
