[
  {
    "start": 0.25,
    "end": 2.045,
    "text": "吃一颗就会上瘾的葡萄，"
  },
  {
    "start": 2.045,
    "end": 2.763,
    "text": "你吃过吗？"
  },
  {
    "start": 2.763,
    "end": 4.02,
    "text": "这就是阳光玫瑰，"
  },
  {
    "start": 4.02,
    "end": 5.636,
    "text": "来自云南高海拔种植，"
  },
  {
    "start": 5.636,
    "end": 6.354,
    "text": "香甜脆爽，"
  },
  {
    "start": 6.354,
    "end": 7.97,
    "text": "还带着浓浓的玫瑰香。"
  },
  {
    "start": 7.97,
    "end": 9.406,
    "text": "每天现采摘、现发货，"
  },
  {
    "start": 9.406,
    "end": 10.663,
    "text": "从广东阳江发出，"
  },
  {
    "start": 10.663,
    "end": 12.099,
    "text": "顺丰空运包邮到家。"
  },
  {
    "start": 12.099,
    "end": 12.997,
    "text": "平时自己吃、"
  },
  {
    "start": 12.997,
    "end": 15.331,
    "text": "下午茶或者招待朋友都很合适。"
  },
  {
    "start": 15.331,
    "end": 17.485,
    "text": "冰镇一下做下午茶，清清爽爽，"
  },
  {
    "start": 17.485,
    "end": 19.46,
    "text": "和家人一起分享也很舒服。"
  },
  {
    "start": 19.46,
    "end": 20.717,
    "text": "想吃阳光玫瑰的，"
  },
  {
    "start": 20.717,
    "end": 21.973,
    "text": "点击下方小黄车，"
  },
  {
    "start": 21.973,
    "end": 23.23,
    "text": "直接带一箱回家。"
  }
]
