[
  {
    "start": 0.25,
    "end": 1.154,
    "text": "买阳光玫瑰，"
  },
  {
    "start": 1.154,
    "end": 2.601,
    "text": "别只挑颜色好看的。"
  },
  {
    "start": 2.601,
    "end": 4.59,
    "text": "真正好吃的，得是香甜脆爽、"
  },
  {
    "start": 4.59,
    "end": 6.218,
    "text": "带着玫瑰香的这一口。"
  },
  {
    "start": 6.218,
    "end": 8.207,
    "text": "这款来自云南高海拔种植，"
  },
  {
    "start": 8.207,
    "end": 9.654,
    "text": "每天现采摘、现发货，"
  },
  {
    "start": 9.654,
    "end": 12.005,
    "text": "从广东阳江顺丰空运包邮到家。"
  },
  {
    "start": 12.005,
    "end": 13.814,
    "text": "家里备水果、下午茶分享，"
  },
  {
    "start": 13.814,
    "end": 16.165,
    "text": "或者朋友来时端上一盘都合适。"
  },
  {
    "start": 16.165,
    "end": 17.792,
    "text": "冰镇后吃起来更清爽，"
  },
  {
    "start": 17.792,
    "end": 20.324,
    "text": "饭后想吃水果时随手拿一串就很"
  },
  {
    "start": 20.324,
    "end": 20.686,
    "text": "满足。"
  },
  {
    "start": 20.686,
    "end": 22.675,
    "text": "想试试的，点击下方小黄车，"
  },
  {
    "start": 22.675,
    "end": 23.76,
    "text": "带一箱慢慢吃。"
  }
]
