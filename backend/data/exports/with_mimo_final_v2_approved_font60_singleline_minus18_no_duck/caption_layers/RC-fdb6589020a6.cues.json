[
  {
    "start": 0.25,
    "end": 2.213,
    "text": "九块九两斤的广东香水柠檬，"
  },
  {
    "start": 2.213,
    "end": 3.522,
    "text": "像这样一层层切好，"
  },
  {
    "start": 3.522,
    "end": 5.322,
    "text": "光看着就很适合夏天泡饮。"
  },
  {
    "start": 5.322,
    "end": 6.795,
    "text": "你看这整果个头也大，"
  },
  {
    "start": 6.795,
    "end": 8.267,
    "text": "黄的青的家里换着泡，"
  },
  {
    "start": 8.267,
    "end": 9.576,
    "text": "喝法一点都不单调。"
  },
  {
    "start": 9.576,
    "end": 11.539,
    "text": "杯里已经放了切片，带冰一端，"
  },
  {
    "start": 11.539,
    "end": 12.848,
    "text": "整杯看着特别清爽。"
  },
  {
    "start": 12.848,
    "end": 14.812,
    "text": "黄柠檬的切面、整果都在这儿，"
  },
  {
    "start": 14.812,
    "end": 16.448,
    "text": "多汁、有维C，泡着喝不苦。"
  },
  {
    "start": 16.448,
    "end": 17.92,
    "text": "最后再倒进透明饮品，"
  },
  {
    "start": 17.92,
    "end": 19.229,
    "text": "想做自己的柠檬饮，"
  },
  {
    "start": 19.229,
    "end": 21.192,
    "text": "趁九块九两斤带回去慢慢喝。"
  }
]
