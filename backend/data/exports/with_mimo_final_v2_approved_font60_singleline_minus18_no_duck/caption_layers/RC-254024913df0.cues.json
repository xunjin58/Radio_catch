[
  {
    "start": 0.25,
    "end": 1.489,
    "text": "喜欢喝柠檬水的，"
  },
  {
    "start": 1.489,
    "end": 2.906,
    "text": "真的可以看看这个，"
  },
  {
    "start": 2.906,
    "end": 4.853,
    "text": "广东香水柠檬九块九两斤，"
  },
  {
    "start": 4.853,
    "end": 6.092,
    "text": "黄的青的搭着泡。"
  },
  {
    "start": 6.092,
    "end": 7.509,
    "text": "你看这切片，个头大，"
  },
  {
    "start": 7.509,
    "end": 9.102,
    "text": "纹理看得清楚，汁水足，"
  },
  {
    "start": 9.102,
    "end": 9.81,
    "text": "维C也有。"
  },
  {
    "start": 9.81,
    "end": 10.518,
    "text": "整个青柠、"
  },
  {
    "start": 10.518,
    "end": 12.289,
    "text": "切开的黄柠檬都给你看，"
  },
  {
    "start": 12.289,
    "end": 13.528,
    "text": "平时不爱喝白水，"
  },
  {
    "start": 13.528,
    "end": 15.298,
    "text": "切两片随手放杯里就行。"
  },
  {
    "start": 15.298,
    "end": 16.892,
    "text": "最后加冰、放进柠檬片，"
  },
  {
    "start": 16.892,
    "end": 18.662,
    "text": "简简单单一杯。多汁不苦，"
  },
  {
    "start": 18.662,
    "end": 19.901,
    "text": "夏天家里备两斤，"
  },
  {
    "start": 19.901,
    "end": 20.964,
    "text": "想喝就自己泡。"
  }
]
