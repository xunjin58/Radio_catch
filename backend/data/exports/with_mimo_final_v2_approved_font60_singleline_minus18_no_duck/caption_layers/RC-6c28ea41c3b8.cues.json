[
  {
    "start": 0.25,
    "end": 2.486,
    "text": "这个广东香水柠檬我真想让你们"
  },
  {
    "start": 2.486,
    "end": 3.604,
    "text": "看看，九块九两斤，"
  },
  {
    "start": 3.604,
    "end": 5.36,
    "text": "黄的青的搭着泡都很好看。"
  },
  {
    "start": 5.36,
    "end": 6.638,
    "text": "先把青柠片放杯里，"
  },
  {
    "start": 6.638,
    "end": 7.596,
    "text": "倒进透明饮品，"
  },
  {
    "start": 7.596,
    "end": 9.513,
    "text": "马上就有一杯柠檬饮的样子。"
  },
  {
    "start": 9.513,
    "end": 10.631,
    "text": "再加一片黄柠檬，"
  },
  {
    "start": 10.631,
    "end": 12.228,
    "text": "镜头一转整果都在这儿，"
  },
  {
    "start": 12.228,
    "end": 13.825,
    "text": "个头大，拿来切片很方便。"
  },
  {
    "start": 13.825,
    "end": 15.741,
    "text": "后面直接挤进杯里，汁水很足，"
  },
  {
    "start": 15.741,
    "end": 17.338,
    "text": "有维C，平时喝着也不苦。"
  },
  {
    "start": 17.338,
    "end": 18.616,
    "text": "黄的青的切片一摆，"
  },
  {
    "start": 18.616,
    "end": 19.733,
    "text": "想自己泡的朋友，"
  },
  {
    "start": 19.733,
    "end": 21.49,
    "text": "九块九两斤带回家慢慢做。"
  }
]
