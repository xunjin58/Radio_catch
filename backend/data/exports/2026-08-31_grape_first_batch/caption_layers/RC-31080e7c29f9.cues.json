[
  {
    "start": 0.25,
    "end": 1.694,
    "text": "如果你也喜欢葡萄，"
  },
  {
    "start": 1.694,
    "end": 3.86,
    "text": "这种一串串挂在园里的画面，"
  },
  {
    "start": 3.86,
    "end": 5.845,
    "text": "总让人想把日子过慢一点。"
  },
  {
    "start": 5.845,
    "end": 7.831,
    "text": "下午茶不用准备得太复杂，"
  },
  {
    "start": 7.831,
    "end": 8.733,
    "text": "洗好装一盘，"
  },
  {
    "start": 8.733,
    "end": 10.177,
    "text": "自己追剧时吃几颗，"
  },
  {
    "start": 10.177,
    "end": 12.163,
    "text": "家人聊天时也能顺手分享。"
  },
  {
    "start": 12.163,
    "end": 14.328,
    "text": "忙完一天，给桌面添一点绿色，"
  },
  {
    "start": 14.328,
    "end": 16.855,
    "text": "也给自己留一段慢慢吃水果的时"
  },
  {
    "start": 16.855,
    "end": 17.036,
    "text": "间。"
  },
  {
    "start": 17.036,
    "end": 18.119,
    "text": "不必等到周末，"
  },
  {
    "start": 18.119,
    "end": 19.382,
    "text": "平常的一餐一茶，"
  },
  {
    "start": 19.382,
    "end": 21.729,
    "text": "也值得有这样一点轻松的陪伴。"
  },
  {
    "start": 21.729,
    "end": 23.714,
    "text": "不必把每一天安排得太满，"
  },
  {
    "start": 23.714,
    "end": 24.797,
    "text": "慢一点，也很好。"
  },
  {
    "start": 24.797,
    "end": 25.88,
    "text": "就这样也很好。"
  }
]
