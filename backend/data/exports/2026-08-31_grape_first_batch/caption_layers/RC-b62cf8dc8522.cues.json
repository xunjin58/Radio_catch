[
  {
    "start": 0.25,
    "end": 1.486,
    "text": "给家里备水果时，"
  },
  {
    "start": 1.486,
    "end": 3.429,
    "text": "葡萄一直是很自然的一项。"
  },
  {
    "start": 3.429,
    "end": 5.195,
    "text": "人多时装一盘放在桌上，"
  },
  {
    "start": 5.195,
    "end": 6.961,
    "text": "大家聊天就能慢慢分享；"
  },
  {
    "start": 6.961,
    "end": 8.903,
    "text": "一个人住，也可以分成小份，"
  },
  {
    "start": 8.903,
    "end": 10.14,
    "text": "按自己的节奏吃。"
  },
  {
    "start": 10.14,
    "end": 12.082,
    "text": "周末看电影、平时下班休息，"
  },
  {
    "start": 12.082,
    "end": 13.318,
    "text": "都不用专门安排，"
  },
  {
    "start": 13.318,
    "end": 15.791,
    "text": "给生活留一点有水果的空当就很"
  },
  {
    "start": 15.791,
    "end": 15.968,
    "text": "好。"
  },
  {
    "start": 15.968,
    "end": 17.734,
    "text": "不必追求特别的仪式感，"
  },
  {
    "start": 17.734,
    "end": 19.146,
    "text": "日常一餐一茶之间，"
  },
  {
    "start": 19.146,
    "end": 20.559,
    "text": "也能留住一点松弛。"
  },
  {
    "start": 20.559,
    "end": 21.972,
    "text": "慢一点，也没有关系。"
  },
  {
    "start": 21.972,
    "end": 23.561,
    "text": "不用把生活排得很满，"
  },
  {
    "start": 23.561,
    "end": 24.444,
    "text": "留一点空当，"
  },
  {
    "start": 24.444,
    "end": 26.034,
    "text": "慢慢吃水果也很舒服。"
  },
  {
    "start": 26.034,
    "end": 27.623,
    "text": "照自己的节奏就很好。"
  }
]
