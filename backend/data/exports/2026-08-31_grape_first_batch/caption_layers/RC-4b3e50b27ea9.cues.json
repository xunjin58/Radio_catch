[
  {
    "start": 0.25,
    "end": 1.985,
    "text": "今天想给家里添点水果，"
  },
  {
    "start": 1.985,
    "end": 3.199,
    "text": "我会先想到葡萄。"
  },
  {
    "start": 3.199,
    "end": 4.934,
    "text": "日常不用设计得太复杂，"
  },
  {
    "start": 4.934,
    "end": 5.975,
    "text": "早上放一小盘，"
  },
  {
    "start": 5.975,
    "end": 7.536,
    "text": "下午工作累了拿几颗，"
  },
  {
    "start": 7.536,
    "end": 9.444,
    "text": "朋友来家里也能一起分享。"
  },
  {
    "start": 9.444,
    "end": 10.832,
    "text": "家里常备一种水果，"
  },
  {
    "start": 10.832,
    "end": 12.047,
    "text": "不是为了多讲究，"
  },
  {
    "start": 12.047,
    "end": 13.261,
    "text": "而是想吃的时候，"
  },
  {
    "start": 13.261,
    "end": 15.169,
    "text": "随手就有一个轻松的选择。"
  },
  {
    "start": 15.169,
    "end": 17.077,
    "text": "不必专门留出一大段时间，"
  },
  {
    "start": 17.077,
    "end": 18.292,
    "text": "平常的一顿饭后，"
  },
  {
    "start": 18.292,
    "end": 19.853,
    "text": "顺手准备一点就够了。"
  },
  {
    "start": 19.853,
    "end": 20.721,
    "text": "不用赶时间，"
  },
  {
    "start": 20.721,
    "end": 22.802,
    "text": "也不用临时再去想要吃什么。"
  },
  {
    "start": 22.802,
    "end": 23.794,
    "text": "忙起来的时候，"
  },
  {
    "start": 23.794,
    "end": 26.107,
    "text": "这样的小安排也能让人放松下来"
  },
  {
    "start": 26.107,
    "end": 26.272,
    "text": "。"
  },
  {
    "start": 26.272,
    "end": 27.66,
    "text": "慢慢来，也不用着急。"
  }
]
