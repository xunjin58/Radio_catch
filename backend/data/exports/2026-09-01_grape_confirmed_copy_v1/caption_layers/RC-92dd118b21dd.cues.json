[
  {
    "start": 0.25,
    "end": 0.784,
    "text": "朋友们，"
  },
  {
    "start": 0.784,
    "end": 2.921,
    "text": "家里水果想换个清甜脆爽的，"
  },
  {
    "start": 2.921,
    "end": 4.345,
    "text": "阳光玫瑰可以试试。"
  },
  {
    "start": 4.345,
    "end": 5.592,
    "text": "云南高海拔种植，"
  },
  {
    "start": 5.592,
    "end": 8.085,
    "text": "近一点的葡萄和整箱装好的葡萄"
  },
  {
    "start": 8.085,
    "end": 10.043,
    "text": "都能看到，也有套袋葡萄园。"
  },
  {
    "start": 10.043,
    "end": 11.468,
    "text": "每天现采摘、现发货，"
  },
  {
    "start": 11.468,
    "end": 12.536,
    "text": "广东阳江发货，"
  },
  {
    "start": 12.536,
    "end": 13.961,
    "text": "顺丰空运包邮到家。"
  },
  {
    "start": 13.961,
    "end": 15.207,
    "text": "香甜脆爽的口感，"
  },
  {
    "start": 15.207,
    "end": 16.81,
    "text": "平时想吃水果的时候，"
  },
  {
    "start": 16.81,
    "end": 18.412,
    "text": "洗好装盘就能端上桌。"
  },
  {
    "start": 18.412,
    "end": 19.303,
    "text": "平时自己吃、"
  },
  {
    "start": 19.303,
    "end": 21.083,
    "text": "送人或家人分享都方便。"
  },
  {
    "start": 21.083,
    "end": 22.864,
    "text": "想吃的点击下方小黄车，"
  },
  {
    "start": 22.864,
    "end": 23.754,
    "text": "直接去下单。"
  }
]
