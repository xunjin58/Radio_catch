[
  {
    "start": 0.25,
    "end": 2.017,
    "text": "吃一颗就会上瘾的葡萄，"
  },
  {
    "start": 2.017,
    "end": 2.724,
    "text": "你吃过吗？"
  },
  {
    "start": 2.724,
    "end": 3.961,
    "text": "这就是阳光玫瑰，"
  },
  {
    "start": 3.961,
    "end": 5.905,
    "text": "云南高海拔种植，香甜脆爽。"
  },
  {
    "start": 5.905,
    "end": 6.965,
    "text": "近一点的葡萄、"
  },
  {
    "start": 6.965,
    "end": 9.44,
    "text": "成串的葡萄和套袋葡萄园都在这"
  },
  {
    "start": 9.44,
    "end": 9.793,
    "text": "条里。"
  },
  {
    "start": 9.793,
    "end": 11.207,
    "text": "每天现采摘、现发货，"
  },
  {
    "start": 11.207,
    "end": 12.267,
    "text": "广东阳江发货，"
  },
  {
    "start": 12.267,
    "end": 13.681,
    "text": "顺丰空运包邮到家。"
  },
  {
    "start": 13.681,
    "end": 14.918,
    "text": "香甜脆爽的口感，"
  },
  {
    "start": 14.918,
    "end": 16.508,
    "text": "平时想吃水果的时候，"
  },
  {
    "start": 16.508,
    "end": 18.099,
    "text": "洗好装盘就能端上桌。"
  },
  {
    "start": 18.099,
    "end": 19.336,
    "text": "自己吃、家人分享、"
  },
  {
    "start": 19.336,
    "end": 20.573,
    "text": "招待朋友都合适。"
  },
  {
    "start": 20.573,
    "end": 22.34,
    "text": "喜欢就点击下方小黄车，"
  },
  {
    "start": 22.34,
    "end": 23.224,
    "text": "直接选一箱。"
  }
]
