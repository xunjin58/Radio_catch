[
  {
    "start": 0.25,
    "end": 0.813,
    "text": "朋友们，"
  },
  {
    "start": 0.813,
    "end": 3.442,
    "text": "现在市面上很受欢迎的葡萄就是"
  },
  {
    "start": 3.442,
    "end": 4.193,
    "text": "阳光玫瑰。"
  },
  {
    "start": 4.193,
    "end": 5.883,
    "text": "很多人买葡萄在意的，"
  },
  {
    "start": 5.883,
    "end": 7.385,
    "text": "无非是香味和口感。"
  },
  {
    "start": 7.385,
    "end": 9.451,
    "text": "这款来自云南高海拔种植，"
  },
  {
    "start": 9.451,
    "end": 10.202,
    "text": "香甜脆爽。"
  },
  {
    "start": 10.202,
    "end": 12.737,
    "text": "园里一串串葡萄和套袋画面都在"
  },
  {
    "start": 12.737,
    "end": 12.918,
    "text": "，"
  },
  {
    "start": 12.918,
    "end": 15.272,
    "text": "日常自己吃或招待朋友都合适。"
  },
  {
    "start": 15.272,
    "end": 16.774,
    "text": "每天现采摘、现发货，"
  },
  {
    "start": 16.774,
    "end": 19.027,
    "text": "广东阳江发货，顺丰空运包邮。"
  },
  {
    "start": 19.027,
    "end": 21.28,
    "text": "香甜脆爽的口感，自己吃不腻，"
  },
  {
    "start": 21.28,
    "end": 23.909,
    "text": "家里来客人时也能端上一盘慢慢"
  },
  {
    "start": 23.909,
    "end": 24.285,
    "text": "分享。"
  },
  {
    "start": 24.285,
    "end": 26.35,
    "text": "想试试的，点击下方小黄车，"
  },
  {
    "start": 26.35,
    "end": 27.665,
    "text": "直接带一箱回家。"
  }
]
