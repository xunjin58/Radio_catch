[
  {
    "start": 0.25,
    "end": 1.323,
    "text": "给家里备水果，"
  },
  {
    "start": 1.323,
    "end": 3.112,
    "text": "阳光玫瑰可以放进清单。"
  },
  {
    "start": 3.112,
    "end": 5.08,
    "text": "云南高海拔种植，香甜脆爽，"
  },
  {
    "start": 5.08,
    "end": 6.512,
    "text": "每天现采摘、现发货。"
  },
  {
    "start": 6.512,
    "end": 7.943,
    "text": "画面里有成串葡萄、"
  },
  {
    "start": 7.943,
    "end": 9.732,
    "text": "采摘和整箱装好的葡萄，"
  },
  {
    "start": 9.732,
    "end": 10.447,
    "text": "平时早餐、"
  },
  {
    "start": 10.447,
    "end": 12.415,
    "text": "下午茶或周末分享都合适。"
  },
  {
    "start": 12.415,
    "end": 13.489,
    "text": "广东阳江发货，"
  },
  {
    "start": 13.489,
    "end": 14.92,
    "text": "顺丰空运包邮到家。"
  },
  {
    "start": 14.92,
    "end": 16.53,
    "text": "香甜脆爽的阳光玫瑰，"
  },
  {
    "start": 16.53,
    "end": 17.782,
    "text": "平时自己吃不腻，"
  },
  {
    "start": 17.782,
    "end": 20.287,
    "text": "家里来客人时端上一盘也很合适"
  },
  {
    "start": 20.287,
    "end": 21.182,
    "text": "，想吃就安排。"
  },
  {
    "start": 21.182,
    "end": 22.792,
    "text": "每一口都是清甜脆爽。"
  },
  {
    "start": 22.792,
    "end": 24.402,
    "text": "想吃清甜脆爽葡萄的，"
  },
  {
    "start": 24.402,
    "end": 26.549,
    "text": "点击下方小黄车，直接去下单，"
  },
  {
    "start": 26.549,
    "end": 27.622,
    "text": "给家里备一箱。"
  }
]
