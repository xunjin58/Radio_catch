[
  {
    "start": 0.25,
    "end": 1.579,
    "text": "想吃一串香甜脆爽、"
  },
  {
    "start": 1.579,
    "end": 3.572,
    "text": "看着就很有食欲的阳光玫瑰，"
  },
  {
    "start": 3.572,
    "end": 5.898,
    "text": "云南高海拔种植的这款可以看看"
  },
  {
    "start": 5.898,
    "end": 6.064,
    "text": "。"
  },
  {
    "start": 6.064,
    "end": 8.458,
    "text": "园里成串的葡萄和采摘画面都在"
  },
  {
    "start": 8.458,
    "end": 9.313,
    "text": "，平时自己吃、"
  },
  {
    "start": 9.313,
    "end": 11.023,
    "text": "下午茶或者家里来客人，"
  },
  {
    "start": 11.023,
    "end": 12.049,
    "text": "都能端上一盘。"
  },
  {
    "start": 12.049,
    "end": 13.416,
    "text": "每天现采摘、现发货，"
  },
  {
    "start": 13.416,
    "end": 14.442,
    "text": "广东阳江发货，"
  },
  {
    "start": 14.442,
    "end": 15.81,
    "text": "顺丰空运包邮到家。"
  },
  {
    "start": 15.81,
    "end": 18.033,
    "text": "一口咬下去是清甜脆爽的口感，"
  },
  {
    "start": 18.033,
    "end": 19.572,
    "text": "平时想吃水果的时候，"
  },
  {
    "start": 19.572,
    "end": 21.282,
    "text": "放在家里就能随时安排。"
  },
  {
    "start": 21.282,
    "end": 22.479,
    "text": "喜欢阳光玫瑰的，"
  },
  {
    "start": 22.479,
    "end": 24.531,
    "text": "点击下方小黄车，选一箱尝尝，"
  },
  {
    "start": 24.531,
    "end": 25.899,
    "text": "想吃时就不用再等。"
  }
]
