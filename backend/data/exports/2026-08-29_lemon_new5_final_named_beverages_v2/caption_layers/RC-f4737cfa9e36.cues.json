[
  {
    "start": 0.25,
    "end": 1.772,
    "text": "一盘柠檬切片先备好，"
  },
  {
    "start": 1.772,
    "end": 3.125,
    "text": "黄色切面铺满盘子，"
  },
  {
    "start": 3.125,
    "end": 4.648,
    "text": "绿色整果也摆在旁边。"
  },
  {
    "start": 4.648,
    "end": 6.678,
    "text": "广东香水柠檬切开以后，切片、"
  },
  {
    "start": 6.678,
    "end": 8.2,
    "text": "挤汁的过程都给你看，"
  },
  {
    "start": 8.2,
    "end": 9.891,
    "text": "汁水顺着果肉落进杯中。"
  },
  {
    "start": 9.891,
    "end": 11.583,
    "text": "冰块和柠檬片放进杯里，"
  },
  {
    "start": 11.583,
    "end": 12.598,
    "text": "接着倒入可乐，"
  },
  {
    "start": 12.598,
    "end": 14.458,
    "text": "气泡随着液面一起升起来。"
  },
  {
    "start": 14.458,
    "end": 15.642,
    "text": "再换一杯矿泉水，"
  },
  {
    "start": 15.642,
    "end": 16.826,
    "text": "把柠檬片放进去，"
  },
  {
    "start": 16.826,
    "end": 18.856,
    "text": "端起来就是两种不同的喝法。"
  },
  {
    "start": 18.856,
    "end": 20.04,
    "text": "想在家做柠檬饮，"
  },
  {
    "start": 20.04,
    "end": 21.732,
    "text": "就照着画面慢慢泡一杯。"
  }
]
