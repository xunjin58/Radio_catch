[
  {
    "start": 0.25,
    "end": 2.317,
    "text": "救命，这柠檬也太新鲜了吧，"
  },
  {
    "start": 2.317,
    "end": 4.384,
    "text": "水珠还挂着呢！九块九两斤，"
  },
  {
    "start": 4.384,
    "end": 5.887,
    "text": "比水果店划算太多"
  },
  {
    "start": 5.887,
    "end": 7.767,
    "text": "手一挤，汁水哗哗往下滴"
  },
  {
    "start": 7.767,
    "end": 10.022,
    "text": "掰开绿柠檬，果肉饱满还没籽"
  },
  {
    "start": 10.022,
    "end": 11.901,
    "text": "杯里挤点汁，气泡水一倒，"
  },
  {
    "start": 11.901,
    "end": 12.84,
    "text": "咕噜咕噜冒"
  },
  {
    "start": 12.84,
    "end": 14.907,
    "text": "黄绿柠檬片同杯，清爽解腻，"
  },
  {
    "start": 14.907,
    "end": 16.975,
    "text": "跟奶茶店十几块一杯没差"
  },
  {
    "start": 16.975,
    "end": 18.854,
    "text": "夏天VC水必须喝起来，"
  },
  {
    "start": 18.854,
    "end": 19.793,
    "text": "姐妹们冲吧！"
  }
]
