[
  {
    "start": 0.25,
    "end": 1.754,
    "text": "可乐柠檬水摆一块，"
  },
  {
    "start": 1.754,
    "end": 3.069,
    "text": "我肯定选柠檬水！"
  },
  {
    "start": 3.069,
    "end": 4.948,
    "text": "九块九两斤的香水柠檬，"
  },
  {
    "start": 4.948,
    "end": 6.264,
    "text": "产地直发真新鲜"
  },
  {
    "start": 6.264,
    "end": 7.956,
    "text": "切片叠一块，皮薄没籽，"
  },
  {
    "start": 7.956,
    "end": 9.835,
    "text": "手一挤，汁水哗哗往外冒"
  },
  {
    "start": 9.835,
    "end": 12.09,
    "text": "气泡水一倒，杯壁全是小水珠"
  },
  {
    "start": 12.09,
    "end": 13.782,
    "text": "薄片丢进杯里飘起来，"
  },
  {
    "start": 13.782,
    "end": 14.721,
    "text": "清爽又解腻，"
  },
  {
    "start": 14.721,
    "end": 16.789,
    "text": "跟奶茶店十几块一杯没差"
  },
  {
    "start": 16.789,
    "end": 18.104,
    "text": "夏天全靠它续命，"
  },
  {
    "start": 18.104,
    "end": 19.796,
    "text": "姐妹们VC水喝起来！"
  }
]
