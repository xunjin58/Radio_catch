[
  {
    "start": 0.25,
    "end": 2.549,
    "text": "家人们谁懂啊，这黄柠檬切开，"
  },
  {
    "start": 2.549,
    "end": 4.656,
    "text": "一颗籽都没有！九块九两斤，"
  },
  {
    "start": 4.656,
    "end": 6.381,
    "text": "水果店一个要十几块"
  },
  {
    "start": 6.381,
    "end": 8.296,
    "text": "手一挤，汁水哗哗全出来！"
  },
  {
    "start": 8.296,
    "end": 10.021,
    "text": "冰杯放几片，可乐一倒，"
  },
  {
    "start": 10.021,
    "end": 11.17,
    "text": "气泡咕噜咕噜，"
  },
  {
    "start": 11.17,
    "end": 13.277,
    "text": "跟奶茶店十几块一杯没差！"
  },
  {
    "start": 13.277,
    "end": 15.576,
    "text": "三片纹理超好看，整颗黄柠檬，"
  },
  {
    "start": 15.576,
    "end": 17.875,
    "text": "清爽又解腻！夏天全靠它续命，"
  },
  {
    "start": 17.875,
    "end": 19.791,
    "text": "姐妹们VC水喝起来呀！"
  }
]
