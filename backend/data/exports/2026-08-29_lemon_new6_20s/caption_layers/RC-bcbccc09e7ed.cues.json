[
  {
    "start": 0.25,
    "end": 1.226,
    "text": "家人们快看，"
  },
  {
    "start": 1.226,
    "end": 3.567,
    "text": "九块九两斤的广东香水柠檬，"
  },
  {
    "start": 3.567,
    "end": 5.909,
    "text": "这价钱还有谁！冰杯放柠檬片，"
  },
  {
    "start": 5.909,
    "end": 7.861,
    "text": "可乐一倒，气泡咕噜咕噜，"
  },
  {
    "start": 7.861,
    "end": 8.836,
    "text": "分层贼好看"
  },
  {
    "start": 8.836,
    "end": 10.593,
    "text": "换杯泡矿泉水，手一挤，"
  },
  {
    "start": 10.593,
    "end": 11.959,
    "text": "汁水哗哗全出来"
  },
  {
    "start": 11.959,
    "end": 14.105,
    "text": "成品挂满水珠，清爽又解腻，"
  },
  {
    "start": 14.105,
    "end": 16.252,
    "text": "跟奶茶店十几块一杯没差！"
  },
  {
    "start": 16.252,
    "end": 17.618,
    "text": "夏天全靠它续命，"
  },
  {
    "start": 17.618,
    "end": 19.764,
    "text": "姐妹们想喝就照着泡一杯！"
  }
]
