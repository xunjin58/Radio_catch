[
  {
    "start": 0.25,
    "end": 2.182,
    "text": "买阳光玫瑰别只看价格，"
  },
  {
    "start": 2.182,
    "end": 3.727,
    "text": "挑的时候记住三点："
  },
  {
    "start": 3.727,
    "end": 6.045,
    "text": "颜色别太青，果粒要饱满紧实，"
  },
  {
    "start": 6.045,
    "end": 7.397,
    "text": "凑近要有玫瑰香，"
  },
  {
    "start": 7.397,
    "end": 8.942,
    "text": "别买到没香没味的。"
  },
  {
    "start": 8.942,
    "end": 9.908,
    "text": "满足这几点，"
  },
  {
    "start": 9.908,
    "end": 11.647,
    "text": "吃起来才会香甜脆爽。"
  },
  {
    "start": 11.647,
    "end": 13.578,
    "text": "湖南阳光玫瑰现采现发，"
  },
  {
    "start": 13.578,
    "end": 15.124,
    "text": "顺丰空运包邮到家，"
  },
  {
    "start": 15.124,
    "end": 17.248,
    "text": "自己吃当水果，送人也方便，"
  },
  {
    "start": 17.248,
    "end": 18.987,
    "text": "家里常备，想吃就取呢，"
  },
  {
    "start": 18.987,
    "end": 20.532,
    "text": "直接点下方小黄车。"
  }
]
