[
  {
    "start": 0.25,
    "end": 2.145,
    "text": "不是只有甜才叫好葡萄，"
  },
  {
    "start": 2.145,
    "end": 3.282,
    "text": "香气也很重要。"
  },
  {
    "start": 3.282,
    "end": 5.746,
    "text": "湖南阳光玫瑰一入口香甜脆爽，"
  },
  {
    "start": 5.746,
    "end": 7.073,
    "text": "后面还有玫瑰香，"
  },
  {
    "start": 7.073,
    "end": 8.779,
    "text": "吃着不是单一的甜味。"
  },
  {
    "start": 8.779,
    "end": 10.864,
    "text": "下午茶、饭后来几颗都合适。"
  },
  {
    "start": 10.864,
    "end": 13.138,
    "text": "每天现采现发，顺丰空运包邮，"
  },
  {
    "start": 13.138,
    "end": 15.223,
    "text": "喜欢这一口就点击小黄车，"
  },
  {
    "start": 15.223,
    "end": 16.929,
    "text": "给家里备点也很合适，"
  },
  {
    "start": 16.929,
    "end": 17.876,
    "text": "自己吃解馋，"
  },
  {
    "start": 17.876,
    "end": 19.393,
    "text": "和家人分享也合适，"
  },
  {
    "start": 19.393,
    "end": 20.53,
    "text": "平时吃也方便。"
  }
]
