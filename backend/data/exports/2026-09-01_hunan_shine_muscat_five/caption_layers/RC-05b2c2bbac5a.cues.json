[
  {
    "start": 0.25,
    "end": 2.111,
    "text": "吃一颗就惦记上的葡萄，"
  },
  {
    "start": 2.111,
    "end": 2.855,
    "text": "你吃过吗？"
  },
  {
    "start": 2.855,
    "end": 4.529,
    "text": "这就是湖南阳光玫瑰，"
  },
  {
    "start": 4.529,
    "end": 5.274,
    "text": "香甜脆爽，"
  },
  {
    "start": 5.274,
    "end": 7.32,
    "text": "带着很有辨识度的玫瑰香。"
  },
  {
    "start": 7.32,
    "end": 8.623,
    "text": "每天现采摘现发，"
  },
  {
    "start": 8.623,
    "end": 10.111,
    "text": "顺丰空运包邮到家。"
  },
  {
    "start": 10.111,
    "end": 12.158,
    "text": "下午茶、饭后或者家里来客，"
  },
  {
    "start": 12.158,
    "end": 13.461,
    "text": "端上一盘都合适。"
  },
  {
    "start": 13.461,
    "end": 15.135,
    "text": "一个人慢慢吃很舒服，"
  },
  {
    "start": 15.135,
    "end": 16.81,
    "text": "想和家人分享也方便，"
  },
  {
    "start": 16.81,
    "end": 18.67,
    "text": "给家里备一份也很省心，"
  },
  {
    "start": 18.67,
    "end": 20.531,
    "text": "想吃直接点下方小黄车。"
  }
]
