[
  {
    "start": 0.25,
    "end": 1.356,
    "text": "很多人买葡萄，"
  },
  {
    "start": 1.356,
    "end": 3.199,
    "text": "最在意的其实不是包装，"
  },
  {
    "start": 3.199,
    "end": 4.305,
    "text": "而是新不新鲜。"
  },
  {
    "start": 4.305,
    "end": 6.702,
    "text": "湖南阳光玫瑰每天现采摘现发，"
  },
  {
    "start": 6.702,
    "end": 8.176,
    "text": "顺丰空运包邮到家。"
  },
  {
    "start": 8.176,
    "end": 9.835,
    "text": "香甜脆爽，还有玫瑰香，"
  },
  {
    "start": 9.835,
    "end": 12.416,
    "text": "自己吃或者给家里人尝尝都合适"
  },
  {
    "start": 12.416,
    "end": 13.706,
    "text": "，冰箱里备上一份，"
  },
  {
    "start": 13.706,
    "end": 14.997,
    "text": "下午嘴馋就能吃，"
  },
  {
    "start": 14.997,
    "end": 17.209,
    "text": "周末追剧或下午茶都很搭呀，"
  },
  {
    "start": 17.209,
    "end": 18.13,
    "text": "平时也能吃。"
  },
  {
    "start": 18.13,
    "end": 19.421,
    "text": "想吃新鲜葡萄的，"
  },
  {
    "start": 19.421,
    "end": 20.527,
    "text": "去小黄车看看。"
  }
]
