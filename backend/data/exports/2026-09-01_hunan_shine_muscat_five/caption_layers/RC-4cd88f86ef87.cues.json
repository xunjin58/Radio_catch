[
  {
    "start": 0.25,
    "end": 1.766,
    "text": "想给家里买葡萄的，"
  },
  {
    "start": 1.766,
    "end": 3.851,
    "text": "先看看这款湖南阳光玫瑰。"
  },
  {
    "start": 3.851,
    "end": 5.557,
    "text": "香甜脆爽，玫瑰香明显，"
  },
  {
    "start": 5.557,
    "end": 6.694,
    "text": "自己吃很满足，"
  },
  {
    "start": 6.694,
    "end": 8.399,
    "text": "拿出来待客也有面子。"
  },
  {
    "start": 8.399,
    "end": 9.726,
    "text": "每天现采摘现发，"
  },
  {
    "start": 9.726,
    "end": 11.242,
    "text": "顺丰空运包邮到家。"
  },
  {
    "start": 11.242,
    "end": 12.758,
    "text": "我从湖南给您发货，"
  },
  {
    "start": 12.758,
    "end": 13.896,
    "text": "平时当水果吃，"
  },
  {
    "start": 13.896,
    "end": 15.601,
    "text": "家人一起分享也合适，"
  },
  {
    "start": 15.601,
    "end": 18.255,
    "text": "周末聚餐也能一起分享更开心呀"
  },
  {
    "start": 18.255,
    "end": 20.529,
    "text": "，想尝尝直接去下方小黄车呢。"
  }
]
