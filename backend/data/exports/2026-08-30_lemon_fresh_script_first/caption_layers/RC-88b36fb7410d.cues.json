[
  {
    "start": 0.25,
    "end": 1.819,
    "text": "气泡水里加两片柠檬，"
  },
  {
    "start": 1.819,
    "end": 4.26,
    "text": "夏天这一口比只喝白水有意思多"
  },
  {
    "start": 4.26,
    "end": 4.434,
    "text": "了。"
  },
  {
    "start": 4.434,
    "end": 5.829,
    "text": "酸香出来得很自然，"
  },
  {
    "start": 5.829,
    "end": 7.049,
    "text": "冰过以后更清爽。"
  },
  {
    "start": 7.049,
    "end": 8.443,
    "text": "不用准备太多东西，"
  },
  {
    "start": 8.443,
    "end": 9.664,
    "text": "味道就很有层次。"
  },
  {
    "start": 9.664,
    "end": 10.884,
    "text": "这个果子汁水足，"
  },
  {
    "start": 10.884,
    "end": 12.627,
    "text": "做饮品不用费心调半天。"
  },
  {
    "start": 12.627,
    "end": 14.894,
    "text": "广东香水柠檬现在九块九两斤，"
  },
  {
    "start": 14.894,
    "end": 16.288,
    "text": "还是果园现摘现发。"
  },
  {
    "start": 16.288,
    "end": 18.38,
    "text": "家里备着，下午想换个口味时，"
  },
  {
    "start": 18.38,
    "end": 20.123,
    "text": "随手就能给自己做一杯，"
  },
  {
    "start": 20.123,
    "end": 20.995,
    "text": "也不容易腻。"
  }
]
