[
  {
    "start": 0.25,
    "end": 2.056,
    "text": "吃完火锅嘴里有点腻时，"
  },
  {
    "start": 2.056,
    "end": 4.224,
    "text": "我会想喝点带柠檬香的冰饮。"
  },
  {
    "start": 4.224,
    "end": 5.669,
    "text": "可乐里加一点酸香，"
  },
  {
    "start": 5.669,
    "end": 7.476,
    "text": "味道更有层次；想轻一点，"
  },
  {
    "start": 7.476,
    "end": 9.101,
    "text": "换成气泡水也很合适。"
  },
  {
    "start": 9.101,
    "end": 10.908,
    "text": "味道有变化，也不怕重复。"
  },
  {
    "start": 10.908,
    "end": 12.172,
    "text": "这个果子汁水足，"
  },
  {
    "start": 12.172,
    "end": 13.617,
    "text": "做一杯不必放太多。"
  },
  {
    "start": 13.617,
    "end": 15.424,
    "text": "按杯买饮料常常十几块，"
  },
  {
    "start": 15.424,
    "end": 17.953,
    "text": "在家备这份九块九两斤的广东香"
  },
  {
    "start": 17.953,
    "end": 19.759,
    "text": "水柠檬，晚餐后想喝就有，"
  },
  {
    "start": 19.759,
    "end": 20.662,
    "text": "更不容易腻。"
  }
]
