[
  {
    "start": 0.25,
    "end": 1.628,
    "text": "九块九买两斤柠檬，"
  },
  {
    "start": 1.628,
    "end": 3.006,
    "text": "到手到底够用多久？"
  },
  {
    "start": 3.006,
    "end": 4.211,
    "text": "平时泡水、做冷饮，"
  },
  {
    "start": 4.211,
    "end": 5.934,
    "text": "几颗就能换出不少口味。"
  },
  {
    "start": 5.934,
    "end": 8.173,
    "text": "这个广东香水柠檬个头很实在，"
  },
  {
    "start": 8.173,
    "end": 8.69,
    "text": "皮也薄，"
  },
  {
    "start": 8.69,
    "end": 10.584,
    "text": "无籽吃起来不用挑来挑去。"
  },
  {
    "start": 10.584,
    "end": 12.134,
    "text": "维C高又是现摘现发，"
  },
  {
    "start": 12.134,
    "end": 13.512,
    "text": "收到手慢慢用就好。"
  },
  {
    "start": 13.512,
    "end": 15.407,
    "text": "周末做一大壶，大家都能喝。"
  },
  {
    "start": 15.407,
    "end": 17.474,
    "text": "家里常做饭、也爱喝饮品的话，"
  },
  {
    "start": 17.474,
    "end": 19.196,
    "text": "放一袋在冰箱里挺踏实，"
  },
  {
    "start": 19.196,
    "end": 20.057,
    "text": "拿着也方便。"
  }
]
