[
  {
    "start": 0.25,
    "end": 1.622,
    "text": "今天吃点什么水果，"
  },
  {
    "start": 1.622,
    "end": 3.509,
    "text": "葡萄可以先放进备选清单。"
  },
  {
    "start": 3.509,
    "end": 5.304,
    "text": "近一点的果粒、整箱的葡萄，"
  },
  {
    "start": 5.304,
    "end": 7.588,
    "text": "再到藤上成串葡萄和套袋的园子"
  },
  {
    "start": 7.588,
    "end": 7.751,
    "text": "，"
  },
  {
    "start": 7.751,
    "end": 10.035,
    "text": "让这份日常选择显得更有画面感"
  },
  {
    "start": 10.035,
    "end": 10.199,
    "text": "。"
  },
  {
    "start": 10.199,
    "end": 12.085,
    "text": "准备水果盘不用过度安排，"
  },
  {
    "start": 12.085,
    "end": 14.315,
    "text": "洗好装盘就能分享给身边的人。"
  },
  {
    "start": 14.315,
    "end": 15.859,
    "text": "家里平常备一点，午后、"
  },
  {
    "start": 15.859,
    "end": 16.888,
    "text": "饭后或聊天时，"
  },
  {
    "start": 16.888,
    "end": 19.118,
    "text": "都有一份不必费心的简单陪伴。"
  },
  {
    "start": 19.118,
    "end": 20.662,
    "text": "不必把生活排得很满，"
  },
  {
    "start": 20.662,
    "end": 22.034,
    "text": "简单准备一点水果，"
  },
  {
    "start": 22.034,
    "end": 23.749,
    "text": "日子也会多出一点轻松。"
  }
]
