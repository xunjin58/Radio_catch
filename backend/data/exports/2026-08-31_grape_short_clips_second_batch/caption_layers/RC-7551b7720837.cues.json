[
  {
    "start": 0.25,
    "end": 2.383,
    "text": "我最近想把日常吃水果这件事，"
  },
  {
    "start": 2.383,
    "end": 3.86,
    "text": "安排得更有一点心意，"
  },
  {
    "start": 3.86,
    "end": 5.501,
    "text": "葡萄就很适合放进清单。"
  },
  {
    "start": 5.501,
    "end": 7.307,
    "text": "成串的葡萄、近一点的果粒，"
  },
  {
    "start": 7.307,
    "end": 8.62,
    "text": "还有套袋的葡萄园，"
  },
  {
    "start": 8.62,
    "end": 10.261,
    "text": "让日常水果多了些层次。"
  },
  {
    "start": 10.261,
    "end": 12.066,
    "text": "放在餐桌上，不用复杂搭配，"
  },
  {
    "start": 12.066,
    "end": 12.886,
    "text": "洗好装一盘，"
  },
  {
    "start": 12.886,
    "end": 14.527,
    "text": "就是很轻松的一份分享。"
  },
  {
    "start": 14.527,
    "end": 15.84,
    "text": "周末和家人一起吃，"
  },
  {
    "start": 15.84,
    "end": 17.81,
    "text": "或者给朋友带一份，都很自然，"
  },
  {
    "start": 17.81,
    "end": 18.466,
    "text": "也很顺手。"
  },
  {
    "start": 18.466,
    "end": 19.943,
    "text": "不用等到特别的日子，"
  },
  {
    "start": 19.943,
    "end": 21.42,
    "text": "平常的一餐一茶之间，"
  },
  {
    "start": 21.42,
    "end": 23.225,
    "text": "也能留一点自己的慢节奏。"
  }
]
