[
  {
    "start": 0.25,
    "end": 2.479,
    "text": "镜头先把切开的柠檬片拿到近处"
  },
  {
    "start": 2.479,
    "end": 3.115,
    "text": "，果肉纹理、"
  },
  {
    "start": 3.115,
    "end": 5.344,
    "text": "切面和叠在一起的果片都能看清"
  },
  {
    "start": 5.344,
    "end": 5.503,
    "text": "。"
  },
  {
    "start": 5.503,
    "end": 7.637,
    "text": "接着杯里放好了冰块和柠檬片，"
  },
  {
    "start": 7.637,
    "end": 9.443,
    "text": "深色饮品沿着杯壁倒进去，"
  },
  {
    "start": 9.443,
    "end": 10.592,
    "text": "气泡跟着冒出来。"
  },
  {
    "start": 10.592,
    "end": 12.726,
    "text": "随后镜头把柠檬片轻轻挤一挤，"
  },
  {
    "start": 12.726,
    "end": 14.203,
    "text": "汁水从果肉里流出来。"
  },
  {
    "start": 14.203,
    "end": 14.86,
    "text": "最后，切片、"
  },
  {
    "start": 14.86,
    "end": 16.83,
    "text": "整果和冰饮一起摆在案板上，"
  },
  {
    "start": 16.83,
    "end": 18.635,
    "text": "想在家做杯冰饮，就切两片、"
  },
  {
    "start": 18.635,
    "end": 19.292,
    "text": "放点冰块，"
  },
  {
    "start": 19.292,
    "end": 21.426,
    "text": "再按自己喜欢的方式搭配饮品。"
  }
]
