# API port used by `npm run dev:api`. The Vite proxy defaults to this local port.
RADIO_CATCH_API_PORT=8001

# Optional: point the frontend at a deployed/local API instead of Vite's proxy.
# VITE_API_URL=http://127.0.0.1:8001

# Backend secret used to encrypt stored model API keys. Replace for any non-demo use.
RADIO_CATCH_SECRET_KEY=replace-with-a-long-random-secret
# Alternatively provide a Fernet-compatible key as RADIO_CATCH_ENCRYPTION_KEY.

# Optional local paths / database URL.
# RADIO_CATCH_DATABASE_URL=sqlite:////absolute/path/radio_catch.db
# RADIO_CATCH_STORAGE_DIR=/absolute/path/media-storage
# RADIO_CATCH_EXPORT_DIR=/absolute/path/exports

# Model defaults are configured inside the app; no keys belong in this file by default.
